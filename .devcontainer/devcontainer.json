{
    "name": "Radar Mikro Nisz - Dev Container",

    // Path to the main compose file(s) (assuming this file lives in .devcontainer/)
    "dockerComposeFile": [
        "../docker-compose.yml",
        "../docker-compose.dev.yml"
    ],

    // Name of the service to work in
    "service": "streamlit-app",

    // Working folder inside the container (matches docker-compose.yml)
    "workspaceFolder": "/app",

    // Install additional tools directly inside the container
    "features": {
        "ghcr.io/devcontainers/features/git:1": {},
        "ghcr.io/devcontainers/features/github-cli:1": {}
    },

    // IDE-specific settings
    "customizations": {
        // PyCharm Professional configuration
        "jetbrains": {
            "plugins": [
                "com.jetbrains.python",    // Python support
                "com.intellij.database",  // Database tools (Postgres)
                "jupyter"                 // Notebook support without port 8888
            ],
            "settings": {
                "python.interpreterPath": "python"
            }
        },
        // Kept for VS Code compatibility
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-toolsai.jupyter",
                "mtxr.sqltools",
                "mtxr.sqltools-driver-pg"
            ]
        }
    },

    // Note: PyCharm handles tunneling itself, so forwardPorts isn't needed for Jupyter
    "forwardPorts": [8501], // Streamlit only, so you can view it in the browser

    // Optional: command to run after the container is built
    // "postCreateCommand": "pip install -r requirements.txt",

    // Action on IDE close (better 'none', so the db-1 database doesn't get stopped)
    "shutdownAction": "none"
}