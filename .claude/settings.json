{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/ruff_format.py\" 2>/dev/null || true",
            "statusMessage": "Running ruff on edited file..."
          }
        ]
      }
    ]
  }
}
